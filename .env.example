# Recommendation submissions open a pull request on this repository.
# Create a fine-grained personal access token at https://github.com/settings/personal-access-tokens
# scoped to ONLY this repository with permissions: Contents (read/write), Pull requests (read/write).
GITHUB_TOKEN=
GITHUB_REPO=noushad15/personal-website
GITHUB_BASE_BRANCH=main

# Optional: POST a JSON notification {subject, text} to this URL on each submission
# (e.g. an InkPigeon send endpoint). Leave empty to rely on GitHub's own PR notifications.
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_AUTH=
